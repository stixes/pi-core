# pi-core headless setup
#
# Copy this file to the FAT partition of a freshly flashed card (the one your
# OS mounts automatically, labelled EFI-SYSTEM) and edit it there. It is read
# once, on first boot of the pi-core image, and then marked done.
#
# Format: KEY=value, one per line. No quotes needed; the rest of the line is
# the value. Lines starting with # are ignored. Unknown keys are reported in
# the journal and otherwise ignored.
#
# Every key is optional. An empty file is valid and changes nothing.

# Hostname to set on first boot.
PI_HOSTNAME=pi-core

# SSH public key authorised for the 'core' user. One key, the whole line.
PI_SSH_KEY=

# Console password for 'core', as a hash — NOT a plaintext password.
# Generate with:  just password-hash     (or: mkpasswd -m yescrypt)
# Worth setting when you have no serial console: without it, a machine that
# boots but never reaches the network cannot be logged into at all.
PI_PASSWORD_HASH=

# System timezone, e.g. Europe/Copenhagen. Left empty, the system default (UTC)
# is kept.
PI_TIMEZONE=

# Tailscale auth key. If set, the host joins the tailnet on first boot.
# This is a secret sitting in plaintext on a removable card — see PI_WIPE_SECRETS.
PI_TAILSCALE_AUTHKEY=

# After a successful run, blank out the secret-bearing lines above
# (PI_PASSWORD_HASH, PI_TAILSCALE_AUTHKEY) in this file. 1 = yes, 0 = keep.
# The card is readable in any laptop; default to wiping.
PI_WIPE_SECRETS=1
