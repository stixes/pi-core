# pi-core first-boot config (Fedora CoreOS aarch64). Model-agnostic: nothing
# here is Pi 4 or Pi 5 specific.
#
# Template: scripts/render-ignition.sh substitutes @HOSTNAME@, @IMAGE@ and
# @PASSWORD_HASH@. Do not edit the rendered .ign by hand.
#
# There is exactly one config, the published image's. No SSH key belongs here:
# the image is handed to strangers, and everything per-device is configured
# after the first login.
variant: fcos
version: 1.5.0

passwd:
  users:
    - name: core
      password_hash: "@PASSWORD_HASH@"
      groups:
        - sudo
        - docker

storage:
  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: "@HOSTNAME@"

    # Marker so we can tell a rebased host from a plain FCOS one at a glance.
    - path: /etc/pi-core-provisioned
      mode: 0644
      contents:
        inline: |
          Provisioned by pi-core ignition for @IMAGE@

    # Also shipped in the image, but the image is not what runs first. Until
    # the rebase succeeds this is stock Fedora CoreOS, which sets
    # PasswordAuthentication no and has no key of ours -- so a machine whose
    # rebase fails is unreachable by every documented route. Sorted 10- because
    # sshd takes the FIRST value for a keyword and FCOS's own drop-in is 40-.
    - path: /etc/ssh/sshd_config.d/10-pi-core-passwords.conf
      mode: 0600
      contents:
        inline: |
          PasswordAuthentication yes

  directories:
    - path: /etc/pi-core-autorebase
      mode: 0755

# U-Boot derives the console from the device tree's stdout-path, which is a
# UART. Without this the kernel logs only to serial and an attached monitor
# goes blank the moment the kernel takes over. Takes effect from the SECOND
# boot (Ignition applies kargs via rpm-ostree), which the autorebase reboot
# provides anyway.
kernel_arguments:
  should_exist:
    - console=tty0
    # Cap the console at 720p. config.txt's framebuffer_width/height cannot do
    # this: Fedora sets disable_fw_kms_setup=1 and loads vc4-kms-v3d, so the
    # kernel takes the mode from EDID and renders the console at the panel's
    # native resolution — 320 columns of 8x16 text on a 1440p monitor, 480 on a
    # 4K one. 720p halves that to 160 columns, which is still a normal terminal
    # width, and it scales by exactly 2 into 1440p and 3 into 4K. The kernel has
    # only 8x8/8x16 fonts compiled in, so resolution is the only lever here.
    # Both HDMI ports, since either may be the one plugged in.
    - video=HDMI-A-1:1280x720@60
    - video=HDMI-A-2:1280x720@60

systemd:
  units:
    # Zincati fights a Universal Blue rebase — learned the hard way on an
    # existing uCore host. Mask it before the rebase runs and let
    # rpm-ostreed-automatic stage updates instead.
    - name: zincati.service
      mask: true

    - name: rpm-ostreed-automatic.timer
      enabled: true

    # The Pi has no battery-backed clock, so it boots believing whatever date
    # the filesystem carried and every TLS handshake fails "certificate is not
    # yet valid" until NTP corrects it. chrony-wait is what makes
    # time-sync.target mean anything; it ships disabled, so without this the
    # target is reached instantly and orders nothing.
    - name: chrony-wait.service
      enabled: true

    # First boot: rebase onto our uCore derivative, then reboot into it.
    #
    # PROTOTYPE: this uses the *unverified* registry transport. Once the image
    # is cosign-signed and our public key ships in the image's container
    # policy, add a second-stage unit that re-rebases onto
    #   ostree-image-signed:docker://@IMAGE@
    # exactly as ublue's examples/ucore-autorebase.butane does.
    - name: pi-core-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=pi-core autorebase to @IMAGE@ and reboot
        ConditionPathExists=!/etc/pi-core-autorebase/done
        After=network-online.target time-sync.target
        Wants=network-online.target time-sync.target
        [Service]
        Type=oneshot
        RemainAfterExit=yes
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-unverified-registry:@IMAGE@
        ExecStart=/usr/bin/touch /etc/pi-core-autorebase/done
        ExecStart=/usr/bin/systemctl disable pi-core-autorebase.service
        ExecStart=/usr/bin/systemctl reboot
        [Install]
        WantedBy=multi-user.target
