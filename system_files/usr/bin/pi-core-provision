#!/bin/bash
# pi-core-provision — apply headless first-boot settings from a config file on
# the card's FAT partition, DietPi-style.
#
# Why this exists: Ignition cannot read a config from a local partition (spec
# v3.5 supports http/https/tftp/s3/arn/gs/data only), and its config is baked
# into the boot partition at install time. So per-device settings would
# otherwise mean re-rendering and re-flashing. This reads a plain file the user
# can edit in any laptop after flashing.
#
# Runs once, guarded by a sentinel. Safe to re-run with --force.
set -uo pipefail

ESP_LABEL=EFI-SYSTEM
CONF_NAME=pi-core.conf
SENTINEL=/var/lib/pi-core/provisioned
CORE_USER=core

# Test hook: point at a directory instead of mounting the ESP.
ESP_DIR_OVERRIDE="${PI_CORE_ESP_DIR:-}"

log()  { echo "pi-core-provision: $*"; }
warn() { echo "pi-core-provision: WARNING: $*" >&2; }

FORCE=0
DRY=0
for arg in "$@"; do
    case "$arg" in
        --force)   FORCE=1 ;;
        --dry-run) DRY=1 ;;
        -h|--help) echo "usage: pi-core-provision [--dry-run] [--force]"; exit 0 ;;
        *)         echo "unknown argument: $arg" >&2; exit 2 ;;
    esac
done

# In dry-run nothing is mutated: report the action and carry on.
run() {
    if [[ "${DRY}" -eq 1 ]]; then
        log "would: $*"
        return 0
    fi
    "$@"
}

if [[ -e "${SENTINEL}" && "${FORCE}" -eq 0 && "${DRY}" -eq 0 ]]; then
    log "already provisioned (${SENTINEL}); nothing to do"
    exit 0
fi

# --- locate the config -------------------------------------------------------
MNT=""
CLEANUP=0
if [[ -n "${ESP_DIR_OVERRIDE}" ]]; then
    MNT="${ESP_DIR_OVERRIDE}"
else
    DEV=$(blkid -L "${ESP_LABEL}" 2>/dev/null || true)
    if [[ -z "${DEV}" ]]; then
        log "no ${ESP_LABEL} partition; nothing to do"
        exit 0
    fi
    MNT=$(mktemp -d /tmp/pi-core-esp.XXXXXX)
    if ! mount "${DEV}" "${MNT}" 2>/dev/null; then
        warn "could not mount ${DEV}"; rmdir "${MNT}"; exit 0
    fi
    CLEANUP=1
fi
finish() {
    if [[ "${CLEANUP}" -eq 1 ]]; then
        umount "${MNT}" 2>/dev/null || true
        rmdir "${MNT}" 2>/dev/null || true
    fi
}
trap finish EXIT

CONF="${MNT}/${CONF_NAME}"
if [[ ! -r "${CONF}" ]]; then
    log "no ${CONF_NAME} on the ${ESP_LABEL} partition; nothing to do"
    exit 0
fi

# --- parse (whitelist; never source an editable file) ------------------------
PI_HOSTNAME=""; PI_SSH_KEY=""; PI_PASSWORD_HASH=""
PI_TIMEZONE=""; PI_TAILSCALE_AUTHKEY=""; PI_WIPE_SECRETS="1"

while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"                      # tolerate CRLF from a Windows edit
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" != *=* ]] && { warn "ignoring malformed line: $line"; continue; }
    key="${line%%=*}"; val="${line#*=}"
    key="$(echo "$key" | tr -d '[:space:]')"
    val="${val#"${val%%[![:space:]]*}"}"      # ltrim
    val="${val%"${val##*[![:space:]]}"}"      # rtrim
    case "$key" in
        PI_HOSTNAME)           PI_HOSTNAME="$val" ;;
        PI_SSH_KEY)            PI_SSH_KEY="$val" ;;
        PI_PASSWORD_HASH)      PI_PASSWORD_HASH="$val" ;;
        PI_TIMEZONE)           PI_TIMEZONE="$val" ;;
        PI_TAILSCALE_AUTHKEY)  PI_TAILSCALE_AUTHKEY="$val" ;;
        PI_WIPE_SECRETS)       PI_WIPE_SECRETS="$val" ;;
        *)                     warn "unknown key '${key}' (ignored)" ;;
    esac
done < "${CONF}"

# --- apply -------------------------------------------------------------------
APPLIED=0

if [[ -n "${PI_HOSTNAME}" ]]; then
    if run hostnamectl set-hostname "${PI_HOSTNAME}" 2>/dev/null; then
        log "hostname set to ${PI_HOSTNAME}"; APPLIED=1
    else
        warn "failed to set hostname"
    fi
fi

if [[ -n "${PI_SSH_KEY}" ]]; then
    HOME_DIR=$(getent passwd "${CORE_USER}" | cut -d: -f6)
    if [[ "${DRY}" -eq 1 ]]; then
        log "would: add SSH key for ${CORE_USER} (${PI_SSH_KEY:0:24}...)"
        APPLIED=1
        HOME_DIR=""
    fi
    if [[ -n "${HOME_DIR}" ]]; then
        install -d -m 0700 -o "${CORE_USER}" -g "${CORE_USER}" "${HOME_DIR}/.ssh"
        AK="${HOME_DIR}/.ssh/authorized_keys"
        if ! grep -qxF "${PI_SSH_KEY}" "${AK}" 2>/dev/null; then
            echo "${PI_SSH_KEY}" >> "${AK}"
            log "added an SSH key for ${CORE_USER}"
        else
            log "SSH key already present"
        fi
        chown "${CORE_USER}:${CORE_USER}" "${AK}"; chmod 0600 "${AK}"
        APPLIED=1
    elif [[ "${DRY}" -eq 0 ]]; then
        warn "user ${CORE_USER} not found; skipping SSH key"
    fi
fi

if [[ -n "${PI_PASSWORD_HASH}" ]]; then
    if [[ "${PI_PASSWORD_HASH}" != \$* ]]; then
        warn "PI_PASSWORD_HASH does not look like a hash (must start with \$) — refusing to set a plaintext password"
    elif [[ "${DRY}" -eq 1 ]]; then
        log "would: set console password for ${CORE_USER}"; APPLIED=1
    elif echo "${CORE_USER}:${PI_PASSWORD_HASH}" | chpasswd -e 2>/dev/null; then
        log "console password set for ${CORE_USER}"; APPLIED=1
    else
        warn "failed to set the password"
    fi
fi

if [[ -n "${PI_TIMEZONE}" ]]; then
    if run timedatectl set-timezone "${PI_TIMEZONE}" 2>/dev/null; then
        log "timezone set to ${PI_TIMEZONE}"; APPLIED=1
    else
        warn "invalid timezone '${PI_TIMEZONE}'"
    fi
fi

if [[ -n "${PI_TAILSCALE_AUTHKEY}" ]]; then
    if [[ "${DRY}" -eq 1 ]]; then
        log "would: join the tailnet with the supplied auth key"; APPLIED=1
    elif command -v tailscale >/dev/null; then
        systemctl enable --now tailscaled 2>/dev/null || true
        if tailscale up --authkey="${PI_TAILSCALE_AUTHKEY}" --hostname="${PI_HOSTNAME:-$(hostname)}" 2>/dev/null; then
            log "joined the tailnet"; APPLIED=1
        else
            warn "tailscale up failed (key expired or already used?)"
        fi
    else
        warn "tailscale not installed; skipping"
    fi
fi

# --- wipe secrets ------------------------------------------------------------
if [[ "${PI_WIPE_SECRETS}" == "1" && "${DRY}" -eq 1 ]]; then
    log "would: blank secret values in ${CONF_NAME}"
elif [[ "${PI_WIPE_SECRETS}" == "1" ]]; then
    if [[ -w "${CONF}" ]]; then
        TMP="${CONF}.tmp"
        sed -E 's/^([[:space:]]*(PI_PASSWORD_HASH|PI_TAILSCALE_AUTHKEY)[[:space:]]*=).*/\1/' \
            "${CONF}" > "${TMP}" && mv "${TMP}" "${CONF}"
        sync
        log "blanked secret values in ${CONF_NAME}"
    else
        warn "cannot write ${CONF_NAME}; secrets left in place"
    fi
fi

if [[ "${DRY}" -eq 0 ]]; then
    mkdir -p "$(dirname "${SENTINEL}")"
    date -Is > "${SENTINEL}" 2>/dev/null || touch "${SENTINEL}"
fi
log "done (applied=${APPLIED})"
