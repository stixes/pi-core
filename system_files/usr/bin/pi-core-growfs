#!/bin/bash
# Grow the root partition and filesystem to fill the card. Runs once.
#
# On the old installer image this came free: Fedora CoreOS grows the root in
# its initramfs, but only on an Ignition firstboot. A pre-rebased image has no
# Ignition, so nothing would ever grow a 2.3 GB root onto a 32 GB card.
#
# growpart also rewrites the GPT backup header to the end of the device. Any
# disk image written to a larger card leaves that header stranded mid-disk,
# which is legal-but-wrong and upsets partition tools later.
set -euo pipefail

MARKER=/var/lib/pi-core/growfs.done
[[ -e "${MARKER}" ]] && exit 0

# /sysroot is the real root on an ostree system; / is a composefs mount and
# findmnt reports it as "composefs", not a block device.
SRC="$(findmnt -no SOURCE /sysroot 2>/dev/null || true)"
[[ "${SRC}" == /dev/* ]] || SRC="$(findmnt -no SOURCE / 2>/dev/null || true)"
if [[ "${SRC}" != /dev/* ]]; then
    echo "pi-core-growfs: root is not a block device (${SRC:-unknown}); nothing to do" >&2
    exit 0
fi

PART="$(basename "${SRC}")"
PARENT="$(lsblk -no PKNAME "${SRC}" 2>/dev/null | head -1)"
NUM="$(cat "/sys/class/block/${PART}/partition" 2>/dev/null || true)"
if [[ -z "${PARENT}" || -z "${NUM}" ]]; then
    echo "pi-core-growfs: cannot resolve ${SRC} to a disk + partition number" >&2
    exit 0
fi

# growpart exits 1 and prints NOCHANGE when the partition already fills the
# disk, which is a success for our purposes.
if growpart "/dev/${PARENT}" "${NUM}"; then
    echo "pi-core-growfs: grew /dev/${PARENT} partition ${NUM}"
else
    echo "pi-core-growfs: partition already at full size"
fi

udevadm settle 2>/dev/null || true

# Grow through /var, not /sysroot. ostree's prepare-root.conf sets
# `[sysroot] readonly = true`, so growing through /sysroot fails with
#   XFS_IOC_FSGROWFSDATA xfsctl failed: Read-only file system
# and the partition ends up bigger while the filesystem does not -- which looks
# exactly like success. /var is a read-write mount of the same filesystem.
# Seen on a Pi 4: partition 29.2G, filesystem 5.5G.
GROW_AT=/var
findmnt -no SOURCE /var >/dev/null 2>&1 || GROW_AT=/sysroot
# Deliberately not silenced: hiding this error is what made the failure look
# like a success in the first place.
xfs_growfs "${GROW_AT}" || true

# Verify rather than trust the exit code. xfs_growfs reports nothing useful
# when it has nothing to do, and "nothing to do" is both the success case on a
# second boot and the failure case when the kernel has stale partition size.
PART_BYTES="$(blockdev --getsize64 "${SRC}" 2>/dev/null || echo 0)"
read -r FS_BLOCKS FS_BSIZE < <(stat -f -c '%b %S' /sysroot)
FS_BYTES=$(( FS_BLOCKS * FS_BSIZE ))
if (( PART_BYTES > 0 && FS_BYTES * 100 >= PART_BYTES * 95 )); then
    echo "pi-core-growfs: root filesystem fills the partition ($(( FS_BYTES / 1024 / 1024 )) MiB)"
    mkdir -p "$(dirname "${MARKER}")"
    touch "${MARKER}"
else
    echo "pi-core-growfs: filesystem is $(( FS_BYTES / 1024 / 1024 )) MiB of a $(( PART_BYTES / 1024 / 1024 )) MiB partition; leaving no marker so this retries" >&2
    exit 1
fi
