[Unit]
Description=pi-core: apply optional headless setup from pi-core.conf on the boot partition
Documentation=file:///usr/share/pi-core/pi-core.conf.example
# NetworkManager must be up for the wifi key to have anything to talk to, and
# this has to run before anything waits on the network -- wireless may be the
# only way this machine is ever reachable.
After=local-fs.target NetworkManager.service pi-core-hostname.service
Wants=NetworkManager.service
# Before pi-core-firmware-check, which mounts the same ESP read-only for
# several seconds while it diffs the overlays directory. A second mount of one
# block device shares its superblock, so overlapping with it makes *our* mount
# read-only and the secret wipe silently impossible. Observed on a Pi 4: the
# check held the ESP from 00:00:15.16 to 00:00:22.86 and this unit ran at
# 00:00:16.76, inside the window, leaving the credentials on the card.
# Ordered this way round because this unit is the fast one and may be what
# brings the network up at all.
Before=network-online.target multi-user.target pi-core-firmware-check.service
# Once. The sentinel is in /var so it survives an upgrade, and the condition is
# here as well as in the script so a provisioned machine costs nothing at boot.
ConditionPathExists=!/var/lib/pi-core/provisioned

[Service]
Type=oneshot
RemainAfterExit=yes
# To the console too: if this is the run that sets up the only network path,
# its failure is something you want on an attached monitor, not just in a
# journal you cannot reach.
StandardOutput=journal+console
ExecStart=/usr/bin/pi-core-provision

[Install]
WantedBy=multi-user.target
