[Unit]
Description=pi-core: apply headless setup from pi-core.conf on the boot partition
Documentation=https://github.com/stixes/pi-core/blob/main/INSTALL.md
After=local-fs.target network.target
Before=multi-user.target
ConditionPathExists=!/var/lib/pi-core/provisioned

[Service]
Type=oneshot
RemainAfterExit=yes
StandardOutput=journal+console
ExecStart=/usr/bin/pi-core-provision

[Install]
WantedBy=multi-user.target
