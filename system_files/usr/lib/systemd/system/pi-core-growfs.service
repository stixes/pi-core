[Unit]
Description=Grow the pi-core root filesystem to fill the card
Documentation=https://github.com/stixes/pi-core
ConditionPathExists=!/var/lib/pi-core/growfs.done
After=local-fs.target
Before=sshd.service

[Service]
Type=oneshot
RemainAfterExit=yes
StandardOutput=journal+console
ExecStart=/usr/bin/pi-core-growfs

[Install]
WantedBy=multi-user.target
