[Unit]
Description=Generate the pi-core login banner
# The banner carries the machine's addresses, so wait for them. Everything else
# it prints is available earlier, but a banner that says "no address" on every
# first login is worse than one that appears a few seconds later.
After=network-online.target pi-core-firmware-check.service
Wants=network-online.target

[Service]
Type=oneshot
# Deliberately not RemainAfterExit: the unit is re-run whenever
# bootc-status-updated.target activates, and a unit that stays "active" would
# never run a second time.
ExecStart=/usr/bin/pi-core-motd

[Install]
# bootc-status-updated.target covers a hand-run `bootc upgrade` or `switch`.
# It does NOT cover the nightly rpm-ostreed-automatic run, whose staging never
# touches /ostree/bootc -- pi-core-motd.path watches the staged-deployment
# marker for that. Both are kept: the target is the earlier signal when bootc
# is the one doing the work.
WantedBy=multi-user.target bootc-status-updated.target
