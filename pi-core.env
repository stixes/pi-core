# pi-core build parameters.
#
# Consumed three ways, which constrains the format: just's `dotenv-load`,
# `source` in scripts/, and appended to $GITHUB_ENV in CI. So every line must
# be a bare KEY=value — no quotes, no inline comments, no spaces around `=`.
# tests/static.sh enforces that, and that all three parsers agree.
#
# Note there is no owner/namespace here on purpose: it is derived by
# scripts/repo-owner.sh so a fork publishes to its own GHCR without edits.
# Override with REPO_ORGANIZATION=... if you need to.

# Base image. ucore-minimal is the right size for a Pi; the full `ucore`
# variant pulls storage tooling incl. mergerfs, which has no aarch64 build.
BASE_IMAGE=ghcr.io/ublue-os/ucore-minimal
BASE_TAG=stable

# Our derivative. The owner half of ghcr.io/<owner>/<image> is derived.
IMAGE_NAME=pi-core
DEFAULT_TAG=stable

# Target platform. Everything here is aarch64 regardless of build host.
PLATFORM=linux/arm64

# Fedora release the firmware payload is pulled from. Keep in step with the
# Fedora version FCOS stable is built on (44 as of 2026-08).
FEDORA_RELEASE=44

