# pi-core build parameters. Sourced by scripts/ and the Makefile.

# Base image. ucore-minimal is the right size for a Pi; the full `ucore`
# variant pulls storage tooling incl. mergerfs, which has no aarch64 build.
BASE_IMAGE="ghcr.io/ublue-os/ucore-minimal"
BASE_TAG="stable"

# Our derivative
IMAGE_NAME="pi-core"
REPO_ORGANIZATION="stixes"        # GitHub owner -> ghcr.io/<owner>/<image>
DEFAULT_TAG="stable"

# Target platform. Everything here is aarch64 regardless of build host.
PLATFORM="linux/arm64"

# Fedora release the firmware payload is pulled from. Keep in step with the
# Fedora version FCOS stable is built on (44 as of 2026-08).
FEDORA_RELEASE="44"

# Fedora CoreOS stream used for the initial SD-card install
FCOS_STREAM="stable"
